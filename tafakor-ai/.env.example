# Tafakor AI add-on configuration. Copy to tafakor-ai/.env (gitignored) and fill in.
# Never commit real keys.

# --- Model access (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional: a different model for receipt/invoice images (defaults to OPENROUTER_MODEL).
OPENROUTER_VISION_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# All external AI calls go through this HTTP proxy (port 8118). From Docker use
# host.docker.internal, never localhost. Credentials may be embedded:
#   http://user:password@host.docker.internal:8118
OPENROUTER_PROXY_URL=http://host.docker.internal:8118

# --- Speech-to-text (optional; OpenAI-compatible /audio/transcriptions endpoint) ---
# Empty SPEECH_BASE_URL disables voice input. Example: https://api.openai.com/v1
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=whisper-1
SPEECH_PROXY_URL=http://host.docker.internal:8118
# Spoken replies (text-to-speech in the browser). Off by default.
AI_TTS_ENABLED=false

# --- Networking ---
# Accounting app as seen from the AI container (direct, never proxied).
AI_ACCOUNTING_URL=http://app:8085
# Hosts that never use the provider proxy.
AI_NO_PROXY=localhost,127.0.0.1,app,db,tafakor-ai
# Docker network of the accounting stack (compose project "tpaccounting" → tpaccounting_internal).
ACCOUNTING_NETWORK=tpaccounting_internal
# Proxy used only while building the image (optional).
BUILD_HTTP_PROXY=

# --- Policy and limits ---
# true = nobody in the company may switch on "Register automatically".
AI_COMPANY_LOCK_AUTO=false
AI_APPROVAL_TTL_SECONDS=600
AI_RATE_LIMIT_PER_MINUTE=30
AI_AUDIT_RETENTION_DAYS=365
MAX_UPLOAD_MB=20
TZ=Asia/Tehran

# In the MAIN .env of the accounting app, enable the integration with:
#   AI_SERVICE_URL=http://tafakor-ai:8090
