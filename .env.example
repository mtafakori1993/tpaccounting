# Copy to .env and change every value marked CHANGE ME before using real data.

# --- Application ---
APP_ENV=production
# Port published on the host and used inside the container.
APP_PORT=8085
# Interface the port is bound to. Use 0.0.0.0 to expose it on the network (put HTTPS in front).
APP_BIND=127.0.0.1
TZ=Asia/Tehran

# --- Database (PostgreSQL service in docker-compose) ---
DB_NAME=tpaccounting
DB_USER=tpaccounting
DB_PASSWORD=CHANGE-ME-use-a-long-random-password

# --- Sessions / security ---
# At least 32 random characters, e.g.: openssl rand -hex 32
SESSION_SECRET=CHANGE-ME-generate-with-openssl-rand-hex-32-0000000000
SESSION_TTL_HOURS=12
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
# Set to true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated origins allowed to call the API from another origin (normally empty).
CORS_ALLOWED_ORIGINS=
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Storage ---
# Attachments are stored on the "attachments" Docker volume.
MAX_UPLOAD_MB=20
